{
  "name": "bloodmc-control-center-v2",
  "version": "1.3.0",
  "private": true,
  "description": "BloodMC Control Center by DEV_ABOUDI",
  "main": "electron/main.cjs",
  "scripts": {
    "build:windows": "electron-builder --win nsis --publish never",
    "build:android": "node scripts/prepare-www.js && cap sync android"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "@capacitor/core": "^7.4.3"
  },
  "build": {
    "appId": "cc.bloodmc.controlcenter",
    "productName": "BloodMC Control Center",
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
